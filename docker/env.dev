# AvroraCore Docker DEV — fixed local secrets (NOT for production).
#
# Source of truth in Rust (keep values identical):
#   dmc_security::dev::{UI_ACCESS_KEY, UI_TOTP_SECRET}
#   dmc_core::control::dev::{MASTER_KEY_HEX, SQL_MASTER_KEY_HEX, MASTER_FILE, …}
#
#   make -f Makefile.docker up-dev
#   make -f Makefile.docker credentials
#
# Compose loads this file via docker-compose.dev.yml (`env_file` + `--env-file`).

# ── Image / ports ───────────────────────────────────────────────────────────
AVRORA_IMAGE=avrora-core:local
RUST_VERSION=1.88
NODE_VERSION=22

AVRORA_HTTP_PORT=18787
AVRORA_CONTROL_PORT=7432
SQL_PORT=15432

INVITE_HOST=127.0.0.1
INVITE_PORT=7432

# ── Dev mode switches ───────────────────────────────────────────────────────
# Entrypoint runs control init + `avrora devo-init` with the keys below.
AVRORA_DEV=1
AVRORA_DEVO_DEMO=1

# ── UI login (browser http://127.0.0.1:18787) ────────────────────────────────
# Access Key ≥ 8 chars. TOTP secret is base32 (A–Z, 2–7), ≥128 bit.
# Add to Google Authenticator via otpauth URL, or:
#   oathtool --totp -b "$AVRORA_UI_TOTP_SECRET"
# otpauth://totp/Avrora:ui?secret=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP&issuer=Avrora
AVRORA_UI_ACCESS_KEY=avrora-dev-ui-key
AVRORA_UI_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# ── Vault Master Key (32 bytes hex = 64 chars) ──────────────────────────────
# Unlock only — never use as UI Access Key.
# Written to /var/lib/avrora/.avrora-dev-master.hex → serve auto-unlocks.
AVRORA_MASTER_KEY_HEX=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ── SQL / pgwire Master Key (separate vault file) ───────────────────────────
SQL_MASTER_KEY_HEX=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# ── Data paths inside the container (usually leave as-is) ───────────────────
AVRORA_HOME=/var/lib/avrora
AVRORA_DATA=/var/lib/avrora/avrora.dbs.json
AVRORA_CONTROL_DIR=/var/lib/avrora/control
AVRORA_ADDR=0.0.0.0:18787
AVRORA_CONTROL_ADDR=0.0.0.0:7432
AVRORA_UI_DIST=/usr/local/share/avrora/ui
SQL_DATA=/var/lib/avrora/sql.dbs.json
SQL_MASTER_KEY=/var/lib/avrora/sql.master.key
SQL_ADDR=0.0.0.0:15432
